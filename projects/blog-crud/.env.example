# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file — it's already in .gitignore.

# --- Database connection ---
# These defaults match a standard XAMPP install (MySQL via phpMyAdmin).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blog_crud

# XAMPP's local MySQL does not need SSL.
DB_SSL=false

# --- Server ---
PORT=3001
